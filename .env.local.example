# Local development/test environment.

OCR_ENGINE=paddleocr_vl
OCR_DEVICE=gpu:0

MODEL_CACHE_DIR=.paddlex_cache

# Local-only image compression before PaddleOCR-VL inference.
# Keep this unset in production to preserve original image quality.
OCR_COMPRESS_MAX_SIDE=640

MAX_IMAGE_BYTES=10485760
LOG_LEVEL=INFO
