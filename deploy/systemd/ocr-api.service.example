[Unit]
Description=OCR API Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/tesrtOCR
EnvironmentFile=/opt/tesrtOCR/.env
ExecStart=/opt/tesrtOCR/.venv/bin/python -m uvicorn api_app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
