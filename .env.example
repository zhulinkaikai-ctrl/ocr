# Copy this file to .env.

# The upload page calls this URL. Local native FastAPI and server Docker both expose /layout-parsing.
OCR_SERVICE_URL=http://127.0.0.1:8080
OCR_SERVICE_TIMEOUT_SECONDS=120

# Windows native Python + FastAPI mode.
OCR_DEVICE=gpu:0
MODEL_CACHE_DIR=.paddlex_cache

# Optional local compression for large images. Leave empty to keep original size.
OCR_COMPRESS_MAX_SIDE=640

# Docker Compose server mode.
API_IMAGE_TAG_SUFFIX=latest-offline
VLM_BACKEND=vllm
VLM_IMAGE_TAG_SUFFIX=latest-offline
