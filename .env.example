# Copy this file to .env on the server, then adjust values for that machine.

# Empty means auto-detect. Use gpu:0 when the server has a working Paddle GPU environment.
OCR_DEVICE=gpu:0

# PaddleOCR model cache directory. Use an absolute path on production servers if preferred.
MODEL_CACHE_DIR=.paddlex_cache

# PP-StructureV3 uses these PP-OCRv6 models for text detection and recognition.
OCR_DETECTION_MODEL=PP-OCRv6_medium_det
OCR_RECOGNITION_MODEL=PP-OCRv6_medium_rec

# CPU inference threads used by PP-StructureV3. Lower this when running high concurrency.
OCR_CPU_THREADS=2

# 10 MB default upload/download file size limit. MAX_IMAGE_BYTES is still accepted for old .env files.
MAX_FILE_BYTES=10485760

# INFO is recommended for production. Use DEBUG only while troubleshooting.
LOG_LEVEL=INFO
